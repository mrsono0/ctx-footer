#!/usr/bin/env python3
"""ci/test-critic-run.sh 전용 모의 codex. 실제 Codex API를 호출하지 않는다.

환경변수:
  MOCK_CODEX_LOG      호출 인자를 탭으로 구분해 기록할 파일 경로(필수)
  MOCK_CODEX_ENV_LOG  전달된 TMPDIR 환경변수를 기록할 파일 경로(선택)
  MOCK_CODEX_RC       종료 코드(기본 0)
  MOCK_CODEX_VERDICT  -o 파일에 쓸 첫 줄(기본 "VERDICT: APPROVE")
"""
import json
import os
import sys

log_path = os.environ.get("MOCK_CODEX_LOG")
if not log_path:
    sys.stderr.write("mock codex: MOCK_CODEX_LOG 미설정\n")
    sys.exit(97)

args = sys.argv[1:]
with open(log_path, "a", encoding="utf-8") as f:
    f.write("\t".join(args) + "\n")

env_log_path = os.environ.get("MOCK_CODEX_ENV_LOG")
if env_log_path:
    with open(env_log_path, "a", encoding="utf-8") as f:
        f.write(os.environ.get("TMPDIR", "") + "\n")

rc = int(os.environ.get("MOCK_CODEX_RC", "0"))
verdict = os.environ.get("MOCK_CODEX_VERDICT", "VERDICT: APPROVE")

out_file = None
if "-o" in args:
    idx = args.index("-o")
    if idx + 1 < len(args):
        out_file = args[idx + 1]
elif "--output-last-message" in args:
    idx = args.index("--output-last-message")
    if idx + 1 < len(args):
        out_file = args[idx + 1]

print(json.dumps({"type": "thread.started", "thread_id": "mock-thread-1"}))
if rc == 0:
    if out_file:
        with open(out_file, "w", encoding="utf-8") as f:
            f.write(verdict + "\n\nmock body\n")
    print(json.dumps({"type": "turn.completed"}))
else:
    print(json.dumps({"type": "turn.failed", "error": {"message": "mock failure"}}))

sys.exit(rc)
