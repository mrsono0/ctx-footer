#!/usr/bin/env python3
"""ci/test-team-core.sh 전용 모의 herdr-app. 실제 Herdr App에 연결하지 않는다.

상태: $MOCK_APP_STATE (JSON).
기록: 모든 호출을 $MOCK_APP_LOG 에 한 줄(인자를 탭으로 연결)씩 남긴다.
"""
import json
import os
import sys

STATE = os.environ.get("MOCK_APP_STATE")
LOG = os.environ.get("MOCK_APP_LOG")
if not STATE or not LOG:
    sys.stderr.write("mock herdr-app: MOCK_APP_STATE/MOCK_APP_LOG 미설정\n")
    sys.exit(97)

args = sys.argv[1:]
with open(LOG, "a", encoding="utf-8") as f:
    f.write("\t".join(args) + "\n")

with open(STATE, encoding="utf-8") as f:
    state = json.load(f)


def save():
    with open(STATE, "w", encoding="utf-8") as f:
        json.dump(state, f, ensure_ascii=False, indent=1)


if not args:
    sys.stderr.write("mock herdr-app: 하위 명령 없음\n")
    sys.exit(2)

sub = args[0]
rest = args[1:]

if sub == "ls":
    ls_count = int(state.get("ls_count") or 0) + 1
    state["ls_count"] = ls_count
    save()
    if state.get("fail_ls"):
        sys.stderr.write("error: herdr-app window is not open\n")
        sys.exit(1)
    appear_on = int(state.get("appear_on_ls") or 1)
    spaces = state.get("spaces") if isinstance(state.get("spaces"), list) else []
    if ls_count < appear_on:
        masked = []
        for sp in spaces:
            if isinstance(sp, dict):
                cp = dict(sp)
                cp["tabs"] = []
                masked.append(cp)
        print(json.dumps({"spaces": masked}, ensure_ascii=False))
        sys.exit(0)
    print(json.dumps({"spaces": spaces}, ensure_ascii=False))
    sys.exit(0)

if sub == "do":
    if not rest or rest[0] != "tab.rename":
        sys.stderr.write(f"mock herdr-app do: 지원하지 않는 명령: {rest}\n")
        sys.exit(2)
    opts = rest[1:]
    tab_id = None
    tab_name = None
    i = 0
    while i < len(opts):
        if opts[i] == "--id" and i + 1 < len(opts):
            tab_id = opts[i + 1]
            i += 2
        elif opts[i] == "--name" and i + 1 < len(opts):
            tab_name = opts[i + 1]
            i += 2
        else:
            sys.stderr.write(f"mock herdr-app do tab.rename: 알 수 없는 인자: {opts[i]}\n")
            sys.exit(2)
    if not tab_id or tab_name is None:
        sys.stderr.write("mock herdr-app do tab.rename: --id 또는 --name 누락\n")
        sys.exit(2)
    rename_rc = int(state.get("rename_rc") or 0)
    if rename_rc != 0:
        sys.stderr.write(str(state.get("rename_stderr") or "error: tab.rename failed") + "\n")
        sys.exit(rename_rc)
    if "rename_response" in state:
        print(json.dumps(state["rename_response"], ensure_ascii=False))
        sys.exit(0)
    for sp in state.get("spaces") or []:
        if not isinstance(sp, dict):
            continue
        for tab in sp.get("tabs") or []:
            if isinstance(tab, dict) and tab.get("id") == tab_id:
                tab["name"] = tab_name
    save()
    print(json.dumps({"ok": True}))
    sys.exit(0)

sys.stderr.write(f"mock herdr-app: 지원하지 않는 하위 명령: {sub}\n")
sys.exit(2)
