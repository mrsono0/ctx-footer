#!/usr/bin/env python3
"""ci/test-team-up.sh 전용 모의 herdr. 실제 Herdr에 연결하지 않는다.

상태: $MOCK_HERDR_STATE (JSON). 키:
  panes  pane 목록. "name" = agent 이름(agent가 실행 중인 pane에만 붙는다, Herdr와 같음), "tab_id" = 탭.
  tabs   탭별 분할 트리. 잎 {"p": pane_id}, 분할 {"d": "down"|"right", "r": 첫 자식 몫, "a": 첫 자식, "b": 둘째}.
         없는 탭은 pane 목록 순서로 만든다: 첫 pane 위(0.6), 나머지는 아래 한 줄 같은 폭.
  next   새 pane·탭 번호.
  auto_sidebar  참이면 --new-tab으로 만든 탭에 agent 없는 "Sidebar" pane을 함께 만든다(사용자 설정 재현).
  late_sidebar  참이면 --new-tab 직후에는 Sidebar를 만들지 않고, 두 번째 pane list(또는 기다리지 않고 되돌릴 때)에 대상 pane의 탭에 늦게 만든다(늦은 Sidebar 경쟁 재현).
  auto_pane_agent  위 Sidebar pane에 줄 agent 종류(시험용, 기본 없음).
  fail   실패시킬 명령 목록(예: ["move"], ["resize"], ["process-info"]).
  fail_once  한 번만 실패시킬 명령 목록(예: ["move"], ["wait_list"], ["wait_timeout"]).
  process_info  pane_id별 process_info 객체({"foreground_processes": [...]}). 미지정 시 기본 기동 argv 반환.
  process_info_raw  pane_id별 원문 stdout 문자열(JSON 오류 시험용).
  process_info_fail  process-info를 실패시킬 pane_id 목록.
  process_info_stderr  process-info 실패 시 stderr에 출력할 문자열.
기록: 모든 호출을 $MOCK_HERDR_LOG 에 한 줄(인자를 탭으로 연결)씩 남긴다.
탭 크기는 100x33(팀장 0.6 → 높이 20).
"""
import json
import os
import sys
import time

STATE = os.environ.get("MOCK_HERDR_STATE")
LOG = os.environ.get("MOCK_HERDR_LOG")
if not STATE or not LOG:
    sys.stderr.write("mock herdr: MOCK_HERDR_STATE/MOCK_HERDR_LOG 미설정\n")
    sys.exit(97)

args = sys.argv[1:]
with open(LOG, "a", encoding="utf-8") as f:
    f.write("\t".join(args) + "\n")

with open(STATE, encoding="utf-8") as f:
    state = json.load(f)
panes = state["panes"]
tabs = state.setdefault("tabs", {})
W, H = 100, 33


def save():
    with open(STATE, "w", encoding="utf-8") as f:
        json.dump(state, f, ensure_ascii=False, indent=1)


def ok(kind, key, obj):
    print(json.dumps({"id": "mock", "result": {key: obj, "type": kind}}, ensure_ascii=False))
    sys.exit(0)


def err(code, msg):
    print(json.dumps({"error": {"code": code, "message": msg}, "id": "mock"}))
    sys.exit(1)


def opt(name):
    if name in args:
        i = args.index(name)
        return args[i + 1] if i + 1 < len(args) else None
    return None


def positional(start):
    """start 이후의 옵션이 아닌 인자들(값을 받는 옵션의 값은 제외)."""
    takes = {"--direction", "--ratio", "--cwd", "--env", "--pane", "--right-click",
             "--source-pane", "--target-pane", "--amount", "--tab", "--split"}
    out, i = [], start
    while i < len(args):
        a = args[i]
        if a in takes:
            i += 2
            continue
        if a.startswith("--"):
            i += 1
            continue
        out.append(a)
        i += 1
    return out


def by_id(pid):
    return next((p for p in panes if p["pane_id"] == pid), None)


def by_agent(target):
    for p in panes:
        if p.get("agent") and (p.get("name") == target or p["pane_id"] == target):
            return p
    return None


def public(p):
    return {k: v for k, v in p.items() if k not in ("name", "command")}


def new_id(prefix):
    n = state.get("next", 1)
    state["next"] = n + 1
    return "%s%d" % (prefix, n)


# --- 분할 트리 ---
def leaves(n):
    return [n["p"]] if "p" in n else leaves(n["a"]) + leaves(n["b"])


def replace_leaf(n, pid, new):
    if "p" in n:
        return new if n["p"] == pid else n
    return dict(n, a=replace_leaf(n["a"], pid, new), b=replace_leaf(n["b"], pid, new))


def remove_leaf(n, pid):
    """pid 잎을 빼고 형제를 위로 올린다. 트리가 비면 None."""
    if "p" in n:
        return None if n["p"] == pid else n
    a, b = remove_leaf(n["a"], pid), remove_leaf(n["b"], pid)
    if a is None:
        return b
    if b is None:
        return a
    return dict(n, a=a, b=b)


def path_to(n, pid, acc=()):
    """루트부터 pid 잎까지 (분할 노드, 'a'|'b') 목록."""
    if "p" in n:
        return list(acc) if n["p"] == pid else None
    return path_to(n["a"], pid, acc + ((n, "a"),)) or path_to(n["b"], pid, acc + ((n, "b"),))


def default_tree(ids):
    if not ids:
        return None
    first = by_id(ids[0]) or {}
    if first.get("agent") in ("agy", "codex") or first.get("label") in ("CF 구현 · agy", "CF 검토 · Codex"):
        row = {"p": ids[-1]}
        for k in range(len(ids) - 2, -1, -1):
            row = {"d": "right", "r": round(1 / (len(ids) - k), 4), "a": {"p": ids[k]}, "b": row}
        return row
    lead, rest = ids[0], ids[1:]
    if not rest:
        return {"p": lead}
    row = {"p": rest[-1]}
    for k in range(len(rest) - 2, -1, -1):
        row = {"d": "right", "r": round(1 / (len(rest) - k), 4), "a": {"p": rest[k]}, "b": row}
    return {"d": "down", "r": 0.6, "a": {"p": lead}, "b": row}


def normalize():
    in_tree = {}
    for t, n in tabs.items():
        for pid in leaves(n):
            in_tree[pid] = t
    for p in panes:
        p["tab_id"] = in_tree.get(p["pane_id"]) or p.get("tab_id") or p["workspace_id"] + ":t1"
    for t in sorted({p["tab_id"] for p in panes} - set(tabs)):
        tree = default_tree([p["pane_id"] for p in panes if p["tab_id"] == t])
        if tree:
            tabs[t] = tree


def rects(n, x, y, w, h, out_p, out_s):
    if "p" in n:
        out_p.append((n["p"], {"x": x, "y": y, "width": w, "height": h}))
        return
    out_s.append({"direction": n["d"], "ratio": n["r"], "id": "split_%d" % len(out_s),
                  "rect": {"x": x, "y": y, "width": w, "height": h}})
    if n["d"] == "down":
        ha = int(round(h * n["r"]))
        rects(n["a"], x, y, w, ha, out_p, out_s)
        rects(n["b"], x, y + ha, w, h - ha, out_p, out_s)
    else:
        wa = int(round(w * n["r"]))
        rects(n["a"], x, y, wa, h, out_p, out_s)
        rects(n["b"], x + wa, y, w - wa, h, out_p, out_s)


def detach(p):
    """pane을 지금 탭의 트리에서 뺀다. 탭이 비면 탭도 없앤다."""
    t = p["tab_id"]
    rest = remove_leaf(tabs[t], p["pane_id"]) if t in tabs else None
    if rest is None:
        tabs.pop(t, None)
    else:
        tabs[t] = rest


def should_fail(name):
    if name in state.get("fail", []):
        return True
    once = state.get("fail_once", [])
    if name in once:
        once.remove(name)
        save()
        return True
    return False


def add_sidebar(p):
    t = p["tab_id"]
    sid = new_id(p["workspace_id"] + ":s")
    side = {"pane_id": sid, "workspace_id": p["workspace_id"], "tab_id": t, "label": "Sidebar",
            "cwd": p.get("cwd"), "foreground_cwd": p.get("cwd")}
    if state.get("auto_pane_agent"):
        side.update(agent=state["auto_pane_agent"], agent_status="idle")
    panes.append(side)
    tabs[t] = replace_leaf(tabs[t], p["pane_id"], {"d": "right", "r": 0.8, "a": {"p": p["pane_id"]}, "b": {"p": sid}})


normalize()
cmd = args[:2]
if cmd == ["pane", "list"]:
    if should_fail("list") or (any(":tm" in t for t in tabs) and should_fail("wait_list")):
        err("list_failed", "mock list failure")
    if any(":tm" in t for t in tabs) and "wait_timeout" in state.get("fail_once", []):
        if state.pop("wait_timeout_armed", False):
            should_fail("wait_timeout")
            time.sleep(3)
        else:
            state["wait_timeout_armed"] = True
            save()
    pend = state.get("pending_sidebar")
    if pend:
        if pend["polls"] > 0:
            pend["polls"] -= 1
        else:
            state.pop("pending_sidebar", None)
            target_p = by_id(pend["pane_id"])
            if target_p:
                add_sidebar(target_p)
        save()
    ok("pane_list", "panes", [public(p) for p in panes])
if cmd == ["pane", "get"]:
    p = by_id(args[2]) if len(args) > 2 else None
    if not p:
        err("pane_not_found", "pane not found")
    ok("pane_info", "pane", public(p))
if cmd == ["agent", "list"]:
    ok("agent_list", "agents", [p for p in panes if p.get("agent")])
if cmd == ["agent", "get"]:
    p = by_agent(args[2]) if len(args) > 2 else None
    if not p:
        err("agent_not_found", "agent target %s not found" % (args[2] if len(args) > 2 else ""))
    ok("agent_info", "agent", {k: v for k, v in p.items() if k != "command"})
if cmd == ["agent", "rename"]:
    target, name = args[2], args[3]
    p = by_agent(target)
    if not p:
        err("agent_not_found", "agent target %s not found" % target)
    holder = by_agent(name)
    if holder and holder is not p:
        err("agent_name_taken", "name %s already used" % name)
    p["name"] = name
    save()
    ok("agent_info", "agent", p)
if cmd == ["pane", "rename"]:
    p = by_id(args[2])
    if not p:
        err("pane_not_found", "pane not found")
    p["label"] = " ".join(args[3:])
    save()
    ok("pane_info", "pane", public(p))
if cmd == ["pane", "split"]:
    pos = positional(2)
    target = pos[0] if pos else os.environ.get("HERDR_PANE_ID")
    src = by_id(target)
    if not src:
        err("pane_not_found", "pane not found")
    pid = new_id(src["workspace_id"] + ":n")
    cwd = opt("--cwd") or src.get("cwd")
    new = {"pane_id": pid, "workspace_id": src["workspace_id"], "tab_id": src["tab_id"], "cwd": cwd,
           "foreground_cwd": cwd, "split_from": target, "split_direction": opt("--direction"),
           "split_ratio": opt("--ratio")}
    panes.insert(panes.index(src) + 1, new)
    tabs[src["tab_id"]] = replace_leaf(tabs[src["tab_id"]], target, {
        "d": opt("--direction") or "right", "r": float(opt("--ratio") or 0.5), "a": {"p": target}, "b": {"p": pid}})
    save()
    ok("pane_info", "pane", public(new))
if cmd == ["pane", "layout"]:
    src = by_id(opt("--pane")) or panes[0]
    t = src["tab_id"]
    out_p, out_s = [], []
    if t in tabs:
        rects(tabs[t], 0, 0, W, H, out_p, out_s)
    out = [{"pane_id": pid, "rect": rect} for pid, rect in out_p]
    ok("pane_layout", "layout", {"tab_id": t, "workspace_id": src["workspace_id"], "panes": out, "splits": out_s})
if cmd == ["pane", "process-info"]:
    pid = opt("--pane") or os.environ.get("HERDR_PANE_ID") or ""
    if should_fail("process-info") or pid in state.get("process_info_fail", []):
        if state.get("process_info_stderr"):
            sys.stderr.write(state["process_info_stderr"] + "\n")
        err("process_info_failed", "mock process-info failure")
    if pid in state.get("process_info_raw", {}):
        sys.stdout.write(state["process_info_raw"][pid] + "\n")
        sys.exit(0)
    p = by_id(pid)
    if not p:
        err("pane_not_found", "pane not found")
    pinfo = state.get("process_info", {}).get(pid)
    if pinfo is None:
        ag = p.get("agent")
        if ag == "agy":
            fg = [{"pid": 101, "name": "agy", "argv": [
                "agy", "--model", "gemini-4-argon-high", "--mode", "accept-edits", "--sandbox"]}]
        elif ag == "codex":
            fg = [{"pid": 102, "name": "codex", "argv": [
                "codex", "--search", "--yolo", "--disable", "worktrees",
                "-m", "gpt-6.1-sol", "-c", "model_reasoning_effort=high"]}]
        elif ag:
            fg = [{"pid": 100, "name": ag, "argv": [ag]}]
        else:
            fg = []
        pinfo = {"foreground_processes": fg}
    ok("pane_process_info", "process_info", pinfo)
if cmd == ["pane", "swap"]:
    a, b = by_id(opt("--source-pane")), by_id(opt("--target-pane"))
    if not a or not b:
        err("pane_not_found", "pane not found")
    ia, ib = panes.index(a), panes.index(b)
    panes[ia], panes[ib] = b, a
    ta, tb = a["tab_id"], b["tab_id"]
    tabs[ta] = replace_leaf(tabs[ta], a["pane_id"], {"p": "\0swap"})
    tabs[tb] = replace_leaf(tabs[tb], b["pane_id"], {"p": a["pane_id"]})
    tabs[ta] = replace_leaf(tabs[ta], "\0swap", {"p": b["pane_id"]})
    a["tab_id"], b["tab_id"] = tb, ta
    save()
    ok("pane_swap", "panes", [a["pane_id"], b["pane_id"]])
if cmd == ["pane", "move"]:
    if should_fail("move"):
        err("move_failed", "mock move failure")
    p = by_id(positional(2)[0] if positional(2) else "")
    if not p:
        err("pane_not_found", "pane not found")
    if "--new-tab" in args:
        detach(p)
        t = new_id(p["workspace_id"] + ":tm")
        p["tab_id"] = t
        tabs[t] = {"p": p["pane_id"]}
        if state.get("auto_sidebar"):
            add_sidebar(p)
        elif state.get("late_sidebar"):
            state["pending_sidebar"] = {"pane_id": p["pane_id"], "polls": 1}
        save()
        ok("pane_move", "move_result", {"changed": True, "created_tab": {"tab_id": t}})
    t, target, d = opt("--tab"), opt("--target-pane"), opt("--split")
    q = by_id(target)
    if t not in tabs or not q or q["tab_id"] != t:
        err("pane_not_found", "target pane not in tab")
    if p["tab_id"] == t:
        ok("pane_move", "move_result", {"changed": False, "reason": "same_tab"})
    detach(p)
    tabs[t] = replace_leaf(tabs[t], target, {"d": d or "right", "r": float(opt("--ratio") or 0.5),
                                              "a": {"p": target}, "b": {"p": p["pane_id"]}})
    p["tab_id"] = t
    pend = state.get("pending_sidebar")
    if pend and pend.get("pane_id") == p["pane_id"]:
        state.pop("pending_sidebar", None)
        add_sidebar(p)
    save()
    ok("pane_move", "move_result", {"changed": True})
if cmd == ["pane", "resize"]:
    if should_fail("resize"):
        err("resize_failed", "mock resize failure")
    p = by_id(opt("--pane") or "")
    if not p:
        err("pane_not_found", "pane not found")
    d, amount = opt("--direction"), float(opt("--amount") or 0.05)
    axis = "down" if d in ("down", "up") else "right"
    for node, side in reversed(path_to(tabs[p["tab_id"]], p["pane_id"]) or []):
        if node["d"] != axis:
            continue
        if side == "a" and d in ("down", "right"):
            node["r"] = round(min(0.95, node["r"] + amount), 4)
        elif side == "b" and d in ("up", "left"):
            node["r"] = round(max(0.05, node["r"] - amount), 4)
        else:
            continue
        save()
        ok("pane_resize", "pane", {"pane_id": p["pane_id"]})
    err("no_split", "no split to resize in that direction")
if cmd == ["tab", "close"]:
    t = args[2] if len(args) > 2 else ""
    if t not in tabs and not any(p["tab_id"] == t for p in panes):
        err("tab_not_found", "tab not found")
    tabs.pop(t, None)
    state["panes"] = [p for p in panes if p["tab_id"] != t]
    save()
    ok("tab_closed", "tab", {"tab_id": t})
if cmd == ["pane", "run"]:
    p = by_id(args[2])
    if not p:
        err("pane_not_found", "pane not found")
    text = " ".join(args[3:])
    words = text.split("&&")[-1].split()
    kind = words[0] if words else ""
    p["command"] = text
    if kind in ("gjc", "codex", "agy", "claude"):
        p["agent"] = kind
        p["agent_status"] = "idle"
        if kind == "agy":
            sid = words[words.index("--conversation") + 1] if "--conversation" in words else "mock-" + p["pane_id"]
            p["agent_session"] = {"value": sid}
    save()
    ok("pane_run", "pane", public(p))


def apply_key_hook(p):
    hooks = p.get("on_key")
    if isinstance(hooks, list) and hooks:
        patch = hooks.pop(0)
        if isinstance(patch, dict):
            p.update(patch)


if cmd == ["pane", "read"]:
    if should_fail("read"):
        err("read_failed", "mock read failure")
    pid = opt("--pane")
    if not pid:
        i = 2
        while i < len(args):
            if args[i] in ("--source", "--format", "--pane", "--lines"):
                i += 2
                continue
            if args[i].startswith("--"):
                i += 1
                continue
            pid = args[i]
            break
    p = by_id(pid) if pid else None
    if not p:
        err("pane_not_found", "pane not found")
    src = opt("--source") or "visible"
    fmt = opt("--format") or ""
    if p.get("expanded") and isinstance(p.get("expanded_pages"), list) and p["expanded_pages"]:
        idx = min(max(int(p.get("page_idx", 0)), 0), len(p["expanded_pages"]) - 1)
        text = p["expanded_pages"][idx]
    elif src == "recent-unwrapped" and "recent_screen" in p:
        text = p["recent_screen"]
    elif fmt == "ansi" and "ansi_screen" in p:
        text = p["ansi_screen"]
    else:
        text = p.get("screen", state.get("screens", {}).get(pid, ""))
    sys.stdout.write(text)
    if text and not text.endswith("\n"):
        sys.stdout.write("\n")
    sys.exit(0)
if cmd == ["pane", "send-keys"]:
    if should_fail("send-keys"):
        err("send_keys_failed", "mock send-keys failure")
    pid = args[2] if len(args) > 2 else ""
    key = args[3] if len(args) > 3 else ""
    p = by_id(pid)
    if not p:
        err("pane_not_found", "pane not found")
    if key.lower() in ("pagedown", "page_down", "pgdn", "pgdown"):
        err("invalid_key", "invalid key: %s" % key)
    if key == "ctrl+g":
        if isinstance(p.get("expanded_pages"), list) and p["expanded_pages"]:
            p["expanded"] = True
            p["page_idx"] = 0
            if p.get("agent") == "agy" and p.get("agent_status") == "blocked":
                p["agent_status"] = "done"
    elif key == "esc":
        if p.get("expanded"):
            p["expanded"] = False
            if p.get("agent") == "agy":
                p["agent_status"] = "blocked"
            if "screen_after_esc" in p:
                p["screen"] = p["screen_after_esc"]
    apply_key_hook(p)
    save()
    sys.exit(0)
if cmd == ["pane", "send-text"]:
    if should_fail("send-text"):
        err("send_text_failed", "mock send-text failure")
    pid = args[2] if len(args) > 2 else ""
    text = args[3] if len(args) > 3 else ""
    p = by_id(pid)
    if not p:
        err("pane_not_found", "pane not found")
    if text == "\x1b[6~" and p.get("expanded") and isinstance(p.get("expanded_pages"), list) and p["expanded_pages"]:
        p["page_idx"] = min(len(p["expanded_pages"]) - 1, int(p.get("page_idx", 0)) + 1)
    apply_key_hook(p)
    save()
    sys.exit(0)
if cmd == ["workspace", "list"]:
    if should_fail("workspace_list"):
        err("workspace_list_failed", "mock workspace list failure")
    wss = state.get("workspaces")
    if wss is None:
        ws_ids = sorted({p.get("workspace_id") for p in panes if p.get("workspace_id")})
        wss = [{"workspace_id": w, "focused": (i == 0)} for i, w in enumerate(ws_ids)]
    ok("workspace_list", "workspaces", wss)

sys.stderr.write("mock herdr: 지원하지 않는 명령: %s\n" % " ".join(args))
sys.exit(2)
