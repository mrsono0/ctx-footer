# ctx-footer: 팀원 간 메시지 전송, 팀원 목록 조회(`herdr agent list`), 보내기 전 입력란 확인(`herdr pane read`)만 샌드박스 밖에서 묻지 않고 허용한다(Codex critic용).
# 근거: https://learn.chatgpt.com/docs/agent-configuration/rules  — 프로젝트 .codex 계층을 신뢰해야 로드되며, 수정 후 Codex 재시작 필요.
prefix_rule(
    pattern = ["herdr", "agent", "prompt"],
    decision = "allow",
    justification = "cf 팀원 간 메시지 전송",
    match = ["herdr agent prompt cf-lead hello"],
    not_match = ["herdr agent rename cf-impl x"],
)
prefix_rule(
    pattern = ["herdr", "pane", ["send-text", "send-keys"]],
    decision = "allow",
    justification = "GJC(cf-impl)에게 send-text + enter로 전송",
    match = ["herdr pane send-text wN:p3 hello", "herdr pane send-keys wN:p3 enter"],
    not_match = ["herdr pane close wN:p3"],
)
prefix_rule(
    pattern = ["herdr", "agent", "list"],
    decision = "allow",
    justification = "보내기 전 팀원 이름·상태 확인(읽기 전용)",
    match = ["herdr agent list"],
    not_match = ["herdr agent rename cf-impl x"],
)
prefix_rule(
    pattern = ["herdr", "pane", "read"],
    decision = "allow",
    justification = "보내기 전 받는 쪽 입력란이 비었는지 확인(읽기 전용)",
    match = ["herdr pane read wN:p1 --source visible"],
    not_match = ["herdr pane close wN:p1"],
)
